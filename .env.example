# ─────────────────────────────────────────────────────────────
# DevTrackAcademy Learn — environment variables
# Copy to .env.local for local development. On AWS Amplify, add the same
# names under App settings → Environment variables (amplify.yml writes them
# into .env.production at build time so the SSR runtime can read them).
# NOTE: Amplify forbids variable names starting with AWS_, hence the S3_ prefix.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for auth redirects and certificate links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon / publishable key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service-role / secret key (server only — never expose)
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails that are promoted to admin on first sign-in
ADMIN_EMAILS=you@example.com

# ── AWS S3 (course images, attachments, downloads) ──
S3_BUCKET=
S3_REGION=ap-south-1
# Optional when Amplify's SSR compute role has S3 access; required elsewhere
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CloudFront domain in front of the bucket's public/ prefix, e.g. https://cdn.example.com
S3_PUBLIC_BASE_URL=

# ── Judge0 compile service (server only; the browser never calls it) ──
# RapidAPI hosted:  https://judge0-ce.p.rapidapi.com   (key → X-RapidAPI-Key)
# Self-hosted:      http://10.0.1.20:2358              (key → X-Auth-Token)
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=

# Rate limits (design §5.5)
COMPILE_RUNS_PER_MINUTE=10
COMPILE_RUNS_PER_DAY=200
COMPILE_CHECKS_PER_MINUTE=5

# ── Terminal sandbox (CheerpX, runs in the learner's browser) ──
# Pinned engine version — never "latest" (design §4.2)
NEXT_PUBLIC_CHEERPX_VERSION=1.3.9
# Idle auto-stop in minutes (0 disables)
NEXT_PUBLIC_SANDBOX_IDLE_MINUTES=30

# ── Razorpay (payments; server only) ──
# Dashboard → Account & Settings → API Keys. Use rzp_test_… keys until launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → the secret you typed when creating the webhook
RAZORPAY_WEBHOOK_SECRET=
# A course purchase unlocks the course for this many months
COURSE_ACCESS_MONTHS=6
# Subscribers keep access this many days past the period end while a renewal retries
SUBSCRIPTION_GRACE_DAYS=5
# Billing cycles authorised when a learner subscribes (Razorpay requires a total)
SUBSCRIPTION_TOTAL_COUNT=60

# ── AI tutor "Glitch" (xAI Grok; server only) ──
# console.x.ai → API Keys
XAI_API_KEY=
XAI_MODEL=grok-4.3
# XAI_BASE_URL=https://api.x.ai/v1
